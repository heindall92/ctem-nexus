{
  "name": "ctem-nexus",
  "version": "1.2.1",
  "private": true,
  "description": "CTEM-Nexus: gestión continua de la exposición a amenazas (CTEM) en el navegador.",
  "type": "module",
  "license": "GPL-2.0-only",
  "author": "Yoandy Ramírez Delgado <yoandyramirezdelgado@gmail.com>",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --mode singlefile && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "golden": "GOLDEN=1 vitest run src/engine/golden.test.ts",
    "typecheck": "tsc -b",
    "capturas": "node scripts/capturas.mjs",
    "guia": "node scripts/guia.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  }
}
