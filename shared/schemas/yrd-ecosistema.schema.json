{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/heindall92/ctem-nexus/blob/main/shared/schemas/yrd-ecosistema.schema.json",
  "title": "Sobre de intercambio del ecosistema (yrd-ecosistema, versión 1)",
  "description": "Formato común de las herramientas de Yoandy Ramírez Delgado: CTEM-Nexus, Rosetta Multinorma, ENS Compliance Studio, KAIROS, ENS AD Auditor, ARGOS y Norvik. El usuario mueve el fichero; las herramientas no se hablan por red.",
  "type": "object",
  "required": ["format", "version", "origen", "tipo", "datos"],
  "properties": {
    "format": { "const": "yrd-ecosistema" },
    "version": { "const": 1 },
    "origen": {
      "type": "object",
      "required": ["herramienta", "version", "generado"],
      "properties": {
        "herramienta": { "enum": ["ctem-nexus", "rosetta", "compliance-studio", "kairos", "ens-ad-auditor", "argos", "norvik"] },
        "version": { "type": "string", "maxLength": 20 },
        "generado": { "type": "string", "description": "Fecha y hora ISO 8601 en UTC (AAAA-MM-DDTHH:MM:SSZ)." }
      }
    },
    "tipo": { "enum": ["hallazgos", "activos", "controles", "bia", "soa", "indicadores", "responsables"] },
    "proyecto": { "type": "string", "maxLength": 120 },
    "resumen": { "type": "object" },
    "datos": { "type": "array", "maxItems": 20000, "items": { "type": "object" } }
  },
  "allOf": [
    {
      "if": { "properties": { "tipo": { "const": "hallazgos" }, "origen": { "properties": { "herramienta": { "const": "ctem-nexus" } } } } },
      "then": { "properties": { "datos": { "items": { "$ref": "#/$defs/evidenciaControl" } } } }
    },
    {
      "if": { "properties": { "tipo": { "const": "controles" } } },
      "then": { "properties": { "datos": { "items": {
        "type": "object", "required": ["control", "estado"],
        "properties": {
          "control": { "$ref": "#/$defs/controlId" },
          "titulo": { "type": "string" },
          "estado": { "enum": ["implantado", "parcial", "pendiente", "no-aplica"] },
          "responsable": { "type": "string" },
          "revision": { "type": "string" },
          "ctem": { "$ref": "#/$defs/evidenciaControl" }
        }
      } } } }
    },
    {
      "if": { "properties": { "tipo": { "const": "responsables" } } },
      "then": { "properties": { "datos": { "items": {
        "type": "object", "required": ["activo", "responsable"],
        "properties": { "activo": { "type": "string", "description": "Identificador, nombre o IP del activo." }, "responsable": { "type": "string" }, "rol": { "type": "string" } }
      } } } }
    },
    {
      "if": { "properties": { "tipo": { "const": "indicadores" } } },
      "then": { "properties": { "datos": { "items": {
        "type": "object", "required": ["indicador", "nombre", "valor", "unidad", "fecha"],
        "properties": {
          "indicador": { "type": "string" }, "nombre": { "type": "string" }, "valor": { "type": ["number", "null"] },
          "unidad": { "type": "string" }, "sentido": { "enum": ["menos", "mas"] }, "fecha": { "type": "string" }
        }
      } } } }
    },
    {
      "if": { "properties": { "tipo": { "const": "activos" }, "origen": { "properties": { "herramienta": { "const": "ctem-nexus" } } } } },
      "then": { "properties": { "datos": { "items": {
        "type": "object", "required": ["activo", "nombre", "criticidad", "abiertos", "riesgoInterrupcion"],
        "properties": {
          "activo": { "type": "string", "description": "Identificador del activo en KAIROS (A-01…)." },
          "nombre": { "type": "string" }, "criticidad": { "type": "integer", "minimum": 1, "maximum": 5 },
          "abiertos": { "type": "integer" }, "criticos": { "type": "integer" }, "altos": { "type": "integer" }, "kev": { "type": "integer" },
          "rutasDeAtaque": { "type": "integer" }, "puntuacionMaxima": { "type": "number" }, "peorHallazgo": { "type": "string" },
          "riesgoInterrupcion": { "enum": ["alto", "medio", "bajo"] }
        }
      } } } }
    }
  ],
  "$defs": {
    "controlId": { "type": "string", "pattern": "^[A-Z]{2,3}-\\d{2}$", "description": "Control unificado de Rosetta Multinorma." },
    "banda": { "enum": ["critica", "alta", "media", "baja"] },
    "evidenciaControl": {
      "type": "object",
      "required": ["control", "abiertos", "porBanda", "hallazgos"],
      "properties": {
        "control": { "$ref": "#/$defs/controlId" },
        "titulo": { "type": "string" },
        "ens": { "type": "array", "items": { "type": "string" } },
        "iso27001": { "type": "array", "items": { "type": "string", "pattern": "^A\\d+\\.\\d+$" }, "description": "Solo identificadores del Anexo A, nunca texto." },
        "nis2": { "type": "array", "items": { "type": "string" } },
        "nist": { "type": "array", "items": { "type": "string" } },
        "dora": { "type": "array", "items": { "type": "string" } },
        "abiertos": { "type": "integer", "minimum": 0 },
        "porBanda": { "type": "object", "properties": { "critica": { "type": "integer" }, "alta": { "type": "integer" }, "media": { "type": "integer" }, "baja": { "type": "integer" } } },
        "kev": { "type": "integer" }, "vencidos": { "type": "integer" }, "peor": { "type": "number", "minimum": 0, "maximum": 100 },
        "hallazgos": { "type": "array", "maxItems": 200, "items": {
          "type": "object", "required": ["id", "banda", "puntuacion"],
          "properties": {
            "id": { "type": "string" }, "titulo": { "type": "string" }, "cve": { "type": ["string", "null"] },
            "banda": { "$ref": "#/$defs/banda" }, "puntuacion": { "type": "number" }, "activo": { "type": "string" },
            "estado": { "enum": ["abierto", "validado", "no_explotable", "mitigado", "aceptado"] }, "vence": { "type": "string" }
          }
        } }
      }
    }
  }
}
